{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm add:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm dlx tsx:*)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.mcp.json)",
      "Read(**/secrets.json)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-env.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Chronorium · lee CLAUDE.md y docs/README.md. El dominio va en la receta, el mecanismo en el codigo. Antes de proponer algo nuevo, mira docs/04-decisiones-adr.md y docs/06-extensibilidad.md por si ya se descarto con motivo.'"
          }
        ]
      }
    ]
  }
}
