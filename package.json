{
  "name": "chronorium",
  "version": "1.0.0",
  "description": "Agente que produce informes periodicos con opinion propia, configurado por receta.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p tests/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node --test",
    "check:sin-datos-personales": "tsx scripts/check-sin-datos-personales.ts",
    "check:receta-ejemplo": "tsx scripts/check-receta-ejemplo.ts",
    "bateria": "node --test 'tests/security/**/*.test.ts'",
    "probe:fase1": "tsx scripts/probe-fase1.ts",
    "probe:fase2": "tsx scripts/probe-fase2.ts",
    "probe:fase3": "tsx scripts/probe-fase3.ts"
  },
  "keywords": [],
  "author": "ivanpascual988@gmail.com",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@ai-sdk/google": "^4.0.37",
    "@ai-sdk/openai": "^4.0.36",
    "@ai-sdk/openai-compatible": "^3.0.25",
    "@rgrove/parse-xml": "^4.2.3",
    "ai": "^7.0.55",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
